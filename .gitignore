# Dependencies
node_modules/
.pnp
.pnp.js

# Environment
#
# .env.local carries this project's Firebase and Supabase config. Those keys
# are public by design — Firebase web config and the Supabase anon key are
# meant to ship to the browser, and Row Level Security is what protects the
# data, not their secrecy. It stays tracked deliberately; the negation below
# is what keeps it that way while everything else stays out.
.env
.env.*
!.env.example
!.env.local

# Build output
dist/
dist-ssr/

# Logs and editor noise
*.log
.DS_Store
.vscode/
.idea/
