# Firebase web app credentials.
#
# Copy this file to .env.local and fill in the values from your Firebase
# console: Project settings -> General -> Your apps -> SDK setup and
# configuration. Restart `npm run dev` afterwards — Vite only reads env files
# at startup.
#
# These values are PUBLIC. Vite inlines them into the client bundle, and a
# Firebase web API key identifies the project rather than authorising anything.
# Security Rules and the Authorized Domains list are what protect your data.
# Never put a service-account key in a VITE_ variable.

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Optional: which OAuth buttons to show ---------------------------------
#
# Apple is OFF by default. Its web flow cannot work from a Firebase toggle
# alone — it needs a Services ID, Team ID, Key ID and .p8 key, all of which
# require a paid Apple Developer account. Showing the button before that is
# configured just gives users one that always fails.
#
# Set this to true once the Apple provider is fully configured in the Firebase
# console. Leaving it unset keeps the button hidden.
VITE_ENABLE_APPLE_SIGNIN=false

# Google is on unless you explicitly turn it off.
# VITE_ENABLE_GOOGLE_SIGNIN=true

# --- File storage (Supabase) -----------------------------------------------
#
# Optional. Without these, the photo-upload buttons keep the prototype's
# "not configured" message and the rest of the app is unaffected.
#
# Authentication stays with Firebase; Supabase is used for Storage only, with
# Firebase ID tokens bridged in via third-party auth. See STORAGE_SETUP.md for
# the dashboard configuration and the SQL policies.
#
# Both values are public — the anon key ships in the bundle by design, and
# Row Level Security is what protects the buckets.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
