# Supabase project credentials.
#
# Copy this file to .env.local and fill in both values from your Supabase
# dashboard under Project Settings -> API. Restart `npm run dev` afterwards —
# Vite only reads env files at startup.
#
# Both values are PUBLIC: Vite inlines them into the client bundle, and the
# anon key is designed to be shipped to browsers. Row Level Security is what
# protects your data. Never put the service_role key in this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
